# ─────────────────────────────────────────────────────────────
# NetSentinel Backend — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below with your real credentials
#   3. NEVER commit the .env file — only .env.example goes to GitHub
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://netsentinel:your_db_password@db:5432/netsentinel

# ── Frontend origin (for CORS) ────────────────────────────────
# In production: replace with your Oracle VM public IP or domain
# Example: http://123.456.789.000
FRONTEND_ORIGIN=http://localhost:3000

# ── Search provider ───────────────────────────────────────────
SEARCH_PROVIDER=searxng

# ── SearXNG ───────────────────────────────────────────────────
# In production: same Docker network so use service name
SEARXNG_URL=http://searxng:8080
SEARXNG_CATEGORIES=general,images

# ── JWT Secret Key ────────────────────────────────────────────
# IMPORTANT: Replace with a long random string in production
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_key