# ─────────────────────────────────────────────────────────────
# NetSentinel — Root .gitignore
# ─────────────────────────────────────────────────────────────

# ── Environment files (NEVER commit real secrets) ─────────────
.env
.env.local
.env.production
.env.development
# Allow the example template
!.env.example

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/

# ── Node / Next.js ────────────────────────────────────────────
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ───────────────────────────────────────────────────
# Keep docker-compose files but ignore override secrets
docker-compose.override.yml

# ── OS junk ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ── Editor config ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/